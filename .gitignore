# dependencies (npm workspaces hoist to the root)
node_modules/

# build output
extension/dist/
web/.next/
web/out/
web/coverage/
*.tsbuildinfo

# Next.js regenerates this on every `next dev`/`next build`, flipping its
# import paths between the two — pure churn, never worth committing.
web/next-env.d.ts

# env files / local secrets — never commit real values, .env.example is fine
.env
.env.*
!.env.example
extension/config.json

# misc
.DS_Store
*.pem
.vercel
npm-debug.log*
.neon

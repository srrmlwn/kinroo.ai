{
  "manifest_version": 3,
  "name": "kinroo.ai",
  "version": "0.2.0",
  "description": "Turn plain English into Google Calendar events.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open kinroo.ai"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the kinroo.ai panel"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "identity", "contextMenus", "scripting", "activeTab", "sidePanel"],
  "host_permissions": ["http://localhost:3000/*", "https://kinroo.ai/*", "https://www.kinroo.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}

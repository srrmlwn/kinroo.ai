# Postgres connection string (Neon recommended — pooled connection for serverless)
DATABASE_URL=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID, type "Web application")
# redirect_uri is supplied per-request by the extension (chrome.identity.getRedirectURL()),
# not fixed here — see SETUP.md for what to register in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session JWT signing (extension <-> backend auth). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest. Must decode to exactly
# 32 bytes. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude API (LLM fallback for parsing; always used for image/PDF input)
ANTHROPIC_API_KEY=
# How calendar questions Claude handles get answered: "select" (default) has
# Claude pick the answering events from the calendar; "keyword" is the older
# title-keyword match with one fewer Claude call. Compare the two with
# `npm run eval:query --workspace=web`.
QUERY_ANSWER_STRATEGY=

# Email ingest (add@<domain>) via SendGrid — see SETUP.md for the Inbound
# Parse + domain auth setup this depends on. Optional: only needed if
# you're standing up the email channel.
SENDGRID_API_KEY=
# The domain SendGrid Inbound Parse is configured for, e.g. mail.kinroo.ai —
# "add" and "confirm+<id>" addresses at this domain are what the extension's
# users email.
EMAIL_INGEST_DOMAIN=
# The root domain SendGrid's Sender Authentication (SPF/DKIM) is set up for,
# e.g. kinroo.ai — used as the "From" domain on outbound mail. Deliberately
# separate from EMAIL_INGEST_DOMAIN: sending "From" a subdomain SendGrid
# hasn't authenticated gets rejected even if it's a subdomain of this one.
EMAIL_FROM_DOMAIN=
# Shared secret appended to the Inbound Parse destination URL
# (.../api/email/inbound?secret=...) since SendGrid doesn't sign webhook
# requests. Generate with: openssl rand -base64 32
EMAIL_INGEST_WEBHOOK_SECRET=

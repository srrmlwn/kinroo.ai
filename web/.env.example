# Postgres connection string (Neon recommended — pooled connection for serverless)
DATABASE_URL=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID, type "Web application")
# redirect_uri is supplied per-request by the extension (chrome.identity.getRedirectURL()),
# not fixed here — see SETUP.md for what to register in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session JWT signing (extension <-> backend auth). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# AES-256-GCM key for encrypting oauth_tokens at rest. Must decode to exactly
# 32 bytes. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude API (LLM fallback for parsing; always used for image/PDF input)
ANTHROPIC_API_KEY=
